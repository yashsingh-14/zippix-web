{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/clone",
      "destination": "/api/clone.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
